{
  "name": "spyne-cli",
  "bin": {
    "spyne-cli": "index.js"
  },
  "type": "module",
  "version": "0.7.1",
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  },
  "description": "Generates spyne objects and saves them to standard spyne.",
  "main": "src/registry.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "src/cli/",
    "src/core/",
    "src/templates/",
    "src/utils/",
    "src/registry.js",
    "src/spyne-file-prompt.js",
    "src/spyne-template-prompts.js",
    "src/ui.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/registry.js",
    "./registry": "./src/registry.js",
    "./core/create-app": "./src/core/create-app.js",
    "./core/generate-module": "./src/core/generate-module.js"
  },
  "scripts": {
    "debug": "nodemon --no-stdin index.js",
    "start": "node index.js",
    "test": "mocha --config mocha.conf.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/spynejs/spyne-cli.git"
  },
